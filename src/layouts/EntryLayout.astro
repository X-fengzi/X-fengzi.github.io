---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  section: string;
  sectionHref: string;
  meta: string;
  tags: string[];
}

const { title, description, section, sectionHref, meta, tags } = Astro.props;
---

<BaseLayout title={`${title} — XFENGZI`} description={description} image={null} isArticle>
  <article class="entry shell">
    <header class="entry-header">
      <a class="back" href={sectionHref}>← 返回{section}</a>
      <p class="eyebrow">{meta}</p>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <div class="entry-meta">
        <span>{tags.map((tag) => `#${tag}`).join(' ')}</span>
        <span>XFENGZI ARCHIVE</span>
      </div>
    </header>
    <div class="entry-body prose">
      <slot />
    </div>
    <footer class="entry-end">
      <span>END OF ENTRY</span>
      <a href={sectionHref}>继续浏览{section} →</a>
    </footer>
  </article>
</BaseLayout>

<style is:global>
  .entry { padding-block: 54px 120px; }
  .entry-header { width: min(100%, 1120px); margin-inline: auto; padding: 50px 0 64px; border-bottom: 1px solid var(--ink); }
  .back { display: inline-block; margin-bottom: 74px; border-bottom: 1px solid; font: 11px var(--mono); }
  .entry-header h1 { max-width: 960px; margin: 34px 0 28px; font-family: var(--display); font-size: clamp(52px, 7vw, 100px); font-weight: 700; letter-spacing: -.075em; line-height: 1.02; }
  .lead { max-width: 700px; margin: 0; color: var(--muted); font-family: var(--sans); font-size: clamp(20px, 2.2vw, 30px); font-weight: 500; line-height: 1.55; }
  .entry-meta { display: flex; justify-content: space-between; gap: 30px; margin-top: 60px; font: 10px var(--mono); letter-spacing: .05em; }
  .prose { width: min(100% - 40px, 760px); margin: 0 auto; padding-block: 74px 100px; font-size: 18px; line-height: 1.95; }
  .prose > :first-child { margin-top: 0; }
  .prose h2 { margin: 2.4em 0 .8em; font-family: var(--display); font-size: clamp(30px, 3.2vw, 44px); letter-spacing: -.05em; line-height: 1.3; }
  .prose h3 { margin-top: 2em; font-size: 22px; }
  .prose p { margin: 1.4em 0; }
  .prose a { color: var(--blue); border-bottom: 1px solid; }
  .prose blockquote { margin: 2.4em 0; padding: 24px 0 24px 28px; border-left: 6px solid var(--signal); font-family: var(--serif); font-size: 24px; font-weight: 700; line-height: 1.65; }
  .prose code { padding: .15em .35em; background: rgba(23,24,21,.08); font-family: var(--mono); font-size: .84em; }
  .prose pre { padding: 22px; overflow-x: auto; }
  .prose pre code { padding: 0; background: transparent; }
  .entry-end { width: min(100%, 1120px); display: flex; justify-content: space-between; margin-inline: auto; padding-top: 24px; border-top: 1px solid var(--ink); font: 10px var(--mono); letter-spacing: .06em; }
  .entry-end a { border-bottom: 1px solid; }

  @media (max-width: 620px) {
    .entry { padding-top: 20px; }
    .back { margin-bottom: 50px; }
    .entry-meta { flex-direction: column; }
    .prose { width: min(100% - 16px, 760px); font-size: 17px; }
  }
</style>
